# Copy this file to `.env` in this folder and fill in your key:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit the real key.
#
# The backend looks for the credential in two places, in this order:
#   1. the workspace-root .env (two levels up), if this project sits inside one
#   2. this project's own .env  <- use this when you have cloned the repo on its own

# Portkey gateway key. Project code reaches OpenAI through Portkey, not directly.
PORTKEY_API_KEY=your-portkey-key-here

# Optional. Defaults to https://api.portkey.ai/v1 when unset.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
